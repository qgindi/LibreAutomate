<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Configurations>Debug</Configurations>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OutputPath>bin</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<LangVersion>preview</LangVersion>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\Au.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Au.TestInternal.cs" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\Au\resources\global2.cs" Link="global2.cs" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="Au.TestInternal.cs" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Vestris.ResourceLib" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Au\Au.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Cpp\Cpp.vcxproj" Private="false" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<Import Project="..\Shared\Shared.projitems" Label="Shared" />
</Project>
